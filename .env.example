# Copy to .env (or export in your shell). Both keys are required for a full run.
ANTHROPIC_API_KEY=sk-ant-...
ASSEMBLYAI_API_KEY=...

# Optional: only for `compare` and `match --retriever embedding|both`.
# The default pipeline never calls Voyage.
# VOYAGE_API_KEY=pa-...

# Optional overrides (defaults shown)
# CONVOS_SEGMENT_MODEL=claude-sonnet-4-6
# CONVOS_CLASSIFY_MODEL=claude-haiku-4-5-20251001
# CONVOS_EMBED_MODEL=voyage-4-lite
