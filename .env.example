# Copy to .env (or export in your shell). All three keys are needed for the
# default configuration. VOYAGE_API_KEY is only optional if you run with
# `--retriever keyword` (or set matching.retriever to "keyword" in feeds.json).
ANTHROPIC_API_KEY=sk-ant-...
ASSEMBLYAI_API_KEY=...
VOYAGE_API_KEY=pa-...

# Optional overrides (defaults shown)
# CONVOS_SEGMENT_MODEL=claude-sonnet-4-6
# CONVOS_CLASSIFY_MODEL=claude-haiku-4-5-20251001
# CONVOS_EMBED_MODEL=voyage-4-lite
